{
  "name": "phantom",
  "productName": "Phantom",
  "version": "2.22.0",
  "private": true,
  "description": "A silent, focused browser for the shadows.",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && electron-builder",
    "build:linux": "vite build && electron-builder --linux",
    "build:win": "vite build && electron-builder --win",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "audit": "yarn npm audit --all"
  },
  "keywords": [
    "electron",
    "browser",
    "productivity",
    "phantom",
    "privacy"
  ],
  "author": "Victor Radael <victorradael@gmail.com>",
  "license": "MIT",
  "resolutions": {
    "tar": "^7.5.7",
    "cross-spawn": "^7.0.5",
    "esbuild": "^0.25.0",
    "semver": "^7.5.4",
    "brace-expansion": "^2.0.2",
    "minimatch": "^9.0.5"
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "electron-updater": "^6.8.3",
    "lucide-react": "^0.309.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.3",
    "@semantic-release/npm": "^13.1.3",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "electron": "^40.1.0",
    "electron-builder": "^26.7.0",
    "eslint": "^9.20.0",
    "eslint-plugin-react": "^7.33.2",
    "postcss": "^8.5.23",
    "semantic-release": "^25.0.3",
    "tailwindcss": "^3.4.1",
    "vite": "7.3.5",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.victorradael.phantom",
    "productName": "Phantom",
    "publish": {
      "provider": "github",
      "owner": "victorradael",
      "repo": "phantom"
    },
    "directories": {
      "output": "dist-release"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "public/icon.png",
      "executableName": "phantom"
    },
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "nsis": {
      "artifactName": "Phantom-Setup-${version}.${ext}"
    },
    "deb": {
      "packageName": "phantom",
      "artifactName": "phantom_${version}_${arch}.${ext}"
    },
    "appImage": {
      "artifactName": "phantom_${version}.${ext}"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "resources/**/*"
    ]
  },
  "packageManager": "yarn@4.13.0"
}
